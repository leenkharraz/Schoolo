# Skoolu Web App — Environment Variables
# Copy this file to .env.local and fill in real values.
# The web app is currently fully static and requires no environment variables at runtime.
# The variables below are only used in the Replit development environment.

# Session secret for the API server (not used by the static web frontend)
SESSION_SECRET=replace_with_a_random_secret_string

# Vite injects BASE_URL automatically based on vite.config.ts — do not set it here.
